/*
 * A narrowed spec program used to run just the Follow-up flow's unit tests while the rest of
 * src/**\/*.spec.ts still carries its pre-existing scaffold compile errors. Identical options to
 * tsconfig.spec.json - only the files the program starts from differ.
 */
{
  "extends": "./tsconfig.spec.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/app/Features/YDot/Donors and Leads/follow-up-*/*.spec.ts"
  ]
}