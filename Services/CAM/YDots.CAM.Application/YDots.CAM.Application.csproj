<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      MediatR IS GONE. Its handlers were found by assembly scanning and dispatched through a
      runtime registry; they are now registered by hand in ServiceContainer/DependencyInjection
      and injected straight into the controllers that use them. See that file for why.

      FluentValidation replaces the hand-rolled Validate() method each handler used to carry
      and the CustomValidationException it threw.
    -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YDots.CAM.Domain\YDots.CAM.Domain.csproj" />
  </ItemGroup>

</Project>
