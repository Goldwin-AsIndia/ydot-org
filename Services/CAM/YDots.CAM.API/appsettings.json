{
  // ===========================================================================================
  // YDot Campaign API.
  //
  // NOTHING SECRET LIVES IN THIS FILE. The connection string and the JWT signing key are both
  // blank here and supplied from the environment:
  //
  //   DatabaseSettings__ConnectionString
  //   JwtSettings__SigningKey
  //
  // THE SIGNING KEY MUST BE THE SAME STRING IAM SIGNS WITH. CAM never issues a token; it only
  // validates the one IAM signed. A mismatch presents as every request answering 401 with
  // nothing in the log to explain why.
  //
  // THE CONNECTION STRING SHOULD POINT AT THE SAME DATABASE AS IAM AND DON. All three share one
  // PostgreSQL database and each owns its own table prefix and its own EF migrations history
  // table: iam_* and gm_* for IAM, don_* for DON, cam_* for CAM.
  // ===========================================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "DatabaseSettings": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true,

    // Logs parameter VALUES. Never enable outside a developer machine.
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },

  "JwtSettings": {
    "SigningKey": "",
    "Issuer": "YDot.IAM",
    "Audience": "YDot.Client",

    // The framework default is five MINUTES, which quietly extends every token past its stated
    // life. Thirty seconds covers real drift between two containers and nothing more.
    "ClockSkewSeconds": 30
  },

  "CampaignSettings": {
    // AutoApproveSuperAdminSubmissions was removed. It let a platform administrator's own
    // submission approve itself, making one person both submitter and approver of the same
    // campaign. Segregation of duties is not configurable - every other approval path already
    // refused the same account.

    // Off by default, which is the safe direction: the readiness checklist exists to stop a
    // campaign launching without its payment configuration or its consent wording.
    "AllowLaunchWithOutstandingChecks": false,

    "MaximumCampaignDurationDays": 1095,
    "DefaultDaysBeforeStart": 7,

    // The base a generated tracking URL is built on. Configuration rather than a constant
    // because it differs per environment, and a tracking link pointing at a staging host in a
    // printed QR code is not recoverable.
    "TrackingBaseUrl": ""
  },

  "ClientAppSettings": {
    // An explicit list, never a wildcard: the client sends a bearer token and credentials, and
    // a browser refuses to send credentials to a wildcard origin.
    "AllowedOrigins": [
      "http://localhost:6701",
      "http://localhost:6700",
      "http://localhost:6702"
    ],
    "BaseUrl": "http://localhost:6701"
  },

  "WhatsAppIntegration": {
    // The WhatsApp screens (CheckNumber and Wati). CAM never calls CheckNumber.ai or WATI and
    // holds neither key: the YDot.Integration worker does the work and keeps the int_* tables in
    // this same database. CAM writes uploaded lists into the worker's inbox and reads its tables.
    "Enabled": true,

    // The worker's data folder AS THIS PROCESS SEES IT - the same folder the worker has as
    // Worker:DataRoot. Blank means "not connected": the pages still show every job the worker
    // has run, and an upload is refused with a sentence saying this setting is missing.
    //   Docker:     /var/ydot/integration (the ydot-integration-data volume; set in compose)
    //   dotnet run: the worker's own data folder (set WhatsAppIntegration__DataRoot)
    "DataRoot": "",

    // The page says 10 MB. nginx allows 12m on this one route for the same reason.
    "MaxUploadMegabytes": 10,

    // The worker reports in every 30 seconds; after this long without a report it is shown as
    // not running. Uploads are still accepted then, and checked when it is back.
    "WorkerOfflineAfterSeconds": 120,

    "MaxLookupNumbers": 50000,
    "MaxListRows": 50000
  },

  "Seq": {
    // Blank disables the Seq sink rather than failing at startup, which is what the previous
    // unconditional WriteTo.Seq(seqUrl!) did on any deployment without a Seq server.
    "ServerUrl": ""
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Sinks.Seq"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },

    "Enrich": [ "FromLogContext" ],

    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/cam-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 14,
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {ServiceName} {CorrelationId} {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ]
  }
}
