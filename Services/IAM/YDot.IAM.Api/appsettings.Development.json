{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    }
  },

  "DatabaseSettings": {
    "ConnectionString": "Host=localhost;Port=5432;Database=ydotphaseupdated;Username=postgres;Password=user;Include Error Detail=true",
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true,

    // Parameter values in the SQL log. Development only: these are real e-mail addresses and
    // password HASHES, and neither belongs in a log file anywhere else.
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true
  },

  "JwtSettings": {
    "SigningKey": "ydot-iam-development-signing-key-please-replace-in-every-real-environment-2026",

    // Shorter than production so the refresh path is exercised while developing rather than
    // discovered in staging.
    "AccessTokenMinutes": 60,

    // Secure=false and SameSite=Lax because the Angular dev server runs over plain HTTP. A
    // Secure cookie is simply not stored by the browser on http://localhost, and the refresh
    // flow would fail with nothing in the logs to explain it.
    "RefreshTokenCookieSecure": false,
    "RefreshTokenCookieSameSite": "Lax"
  },

  "TenancySettings": {
    // localhost, so ten1.localhost resolves to the "ten1" Organisation the same way
    // ten1.ngoplanet.com does in production.
    "RootDomain": "localhost",
    "PlatformHosts": [ "localhost", "www.localhost", "127.0.0.1" ],

    // The X-Tenant header is honoured HERE ONLY, and even here only from loopback — see
    // TenantResolutionMiddleware. It exists so Swagger can exercise a Tenant endpoint without
    // editing the hosts file. It is off in appsettings.json and must stay off.
    "AllowHeaderOverrideOnLoopback": true,

    // The Angular dev server and the API are on different ports, so the host the token was
    // issued for and the host it is presented on legitimately differ.
    "EnforceTokenHostBinding": false
  },

  // Mail relay OFF for local testing.
  //
  // With it off, the activation link comes back on the create-organisation response and is
  // written to the log, so the whole invite -> activate -> sign-in flow can be walked without
  // a mailbox. With it on, the link is deliberately withheld from both - a live activation
  // link in an API response is a live activation link in a log file.
  //
  // The SMTP credential below is a real one. It lives HERE, in a gitignored file that is also
  // excluded from the Docker image, and not in the tracked appsettings.json.
  // THIS FILE IS GIT-IGNORED, which is the only reason a credential may sit in it. Anything
  // that ships needs EmailSettings__SmtpUsername and EmailSettings__SmtpPassword from the
  // environment, or `dotnet user-secrets`.
  "EmailSettings": {
    // ON, so a local run actually sends. Turn it off and every message - activation links
    // included - goes to the log instead, which is how the seed data is meant to be walked
    // when nobody wants mail arriving.
    "Enabled": true,

    // HOSTINGER over SMTP, port 465 with implicit TLS. This file is git-ignored, which is the only
    // reason a real credential may sit in it - the same reason the Resend API key it replaced
    // could.
    //
    // THIS SECTION ONLY APPLIES OUTSIDE DOCKER. A container run reads the same credential from
    // .env by way of EmailSettings__* in docker-compose.yml, and environment variables win over
    // this file, so the two have to be changed together or a local run and a container run send
    // through different relays.
    //
    // THE CREDENTIALS ARE NOT IN THIS FILE, AND MUST NOT BE PUT BACK. Despite what the header
    // above says, THIS FILE IS TRACKED BY GIT - .gitignore covers .env and .env.example and
    // nothing else - so anything written here is one `git commit` away from being permanent and
    // public. The committed version has always had these two blank; keeping them that way is the
    // only reason no credential has ever reached the history.
    //
    // THEY LIVE IN USER SECRETS INSTEAD, which is what the note in appsettings.json already
    // pointed at. The store sits outside the repository entirely, under
    // %APPDATA%\Microsoft\UserSecrets\<UserSecretsId>, and WebApplication.CreateBuilder loads it
    // automatically in Development. To set or rotate them:
    //
    //   dotnet user-secrets set "EmailSettings:SmtpUsername" "notifications@yourdomain.com" \
    //     --project Services/IAM/YDot.IAM.Api
    //   dotnet user-secrets set "EmailSettings:SmtpPassword" "<mailbox password>" \
    //     --project Services/IAM/YDot.IAM.Api
    //
    // A CONTAINER RUN DOES NOT USE THEM: it reads the same credential from .env by way of
    // EmailSettings__* in docker-compose.yml. Two stores, one relay - rotate in both.
    "SmtpHost": "smtp.hostinger.com",
    "SmtpPort": 465,
    "SmtpUsername": "",
    "SmtpPassword": "",

    // IGNORED AT 465, which is implicit TLS - the transport reads the handshake from the port.
    // It would apply if this were switched to 587.
    "UseStartTls": true,

    // THE AUTHENTICATED MAILBOX ITSELF. Hostinger sends only as that mailbox or one of its
    // aliases and refuses anything else, so this is not a free choice. Blank would resolve to
    // SmtpUsername and be equally correct; it is spelled out because the two being identical is a
    // property of this relay rather than of the platform.
    "SenderAddress": "notifications@ascendingsoftware.com",

    // "Your Application" was the display name in the supplied configuration; NGoPlanet is the
    // brand this environment actually uses, and it is what a recipient sees beside the address.
    "SenderName": "NGoPlanet",

    // THE USUAL GUARD against a restored production database mailing real people from a
    // developer's laptop: every message goes here with the intended recipient in the subject.
    "RedirectAllToAddress": "rajat.sivan@gmail.com"
  },

  "ClientAppSettings": {
    "BaseUrl": "http://localhost:6701",
    "AllowedOrigins": [
      "http://localhost:6701",
      "https://localhost:6701",
      "http://ten1.localhost:6701",
      "http://ten2.localhost:6701",
      "http://ten3.localhost:6701"
    ]
  },

  "SeedSettings": {
    "Enabled": true,
    "SuperAdminPassword": "SuperAdmin@2026",
    "RootDomain": "localhost",
    "SeedSampleTenants": true
  }
}
