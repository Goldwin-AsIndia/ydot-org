{
  // ===========================================================================================
  // NO SECRET LIVES IN THIS FILE.
  //
  // Every value below that is blank is supplied at run time - by appsettings.Development.json
  // for a local `dotnet run`, and by environment variables for a container. This file is
  // published INTO the image, so anything written here travels to whoever pulls the image.
  //
  // The environment-variable names are the configuration path with "__" between segments:
  //
  //   DatabaseSettings__ConnectionString
  //   JwtSettings__SigningKey
  //   EmailSettings__SmtpUsername      EmailSettings__SmtpPassword
  //   EmailSettings__SenderAddress
  //   SeedSettings__SuperAdminEmail    SeedSettings__SuperAdminPassword
  //   SeedSettings__SuperAdminFirstName SeedSettings__SuperAdminLastName
  //
  // See docker-compose.yml, where the IAM service sets all of them.
  // ===========================================================================================

  "AllowedHosts": "*",
  "Seq": {
    // Blank disables the Seq sink rather than failing at startup, which is what the previous
    // unconditional WriteTo.Seq(seqUrl!) did on any deployment without a Seq server.
    "ServerUrl": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/ydot-iam-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 30,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{X-Correlation-Id}] [{TenantCode}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": ""
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  // Local defaults. Docker overrides every one of these through DocumentStorageSettings__*
  // environment variables; these values are what "dotnet run" on this machine uses.
  "DocumentStorageSettings": {
    "Endpoint": "localhost:6712",
    "PublicEndpoint": "localhost:6712",
    "UseSsl": false,
    "PublicUseSsl": false,
    "AccessKey": "ydotminio",
    "SecretKey": "ydotminio2026",
    "BucketName": "ydot-organisation-documents",
    "MaximumFileSizeMegabytes": 5,
    "MaximumFilesPerSubmission": 10,
    "DownloadLinkExpirySeconds": 300
  },

  "DatabaseSettings": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },

  "JwtSettings": {
    "Issuer": "YDot.IAM",
    "Audience": "YDot.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "MfaPendingTokenMinutes": 10,
    "TenantSelectionTokenMinutes": 15,
    "StepUpValidMinutes": 5,
    "ClockSkewSeconds": 30,
    "RefreshTokenCookieName": "ydot_rt",
    "RefreshTokenCookieSecure": true,
    "RefreshTokenCookieSameSite": "None"
  },

  "SecuritySettings": {
    "MaximumFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "WarnWhenAttemptsRemaining": 2,
    "PasswordMinimumLength": 10,
    "PasswordMaximumLength": 128,
    "PasswordRequireUppercase": true,
    "PasswordRequireLowercase": true,
    "PasswordRequireDigit": true,
    "PasswordRequireNonAlphanumeric": true,
    "PasswordHistoryCount": 5,
    "PasswordExpiryDays": 0,
    "SessionIdleTimeoutMinutes": 30,
    "SessionAbsoluteTimeoutHours": 12,
    "MaximumConcurrentSessions": 10,
    "InvitationExpiryDays": 7,
    "PasswordResetExpiryMinutes": 60,
    "EmailConfirmationExpiryHours": 24,
    "MfaChallengeExpiryMinutes": 5,
    "MfaMaximumAttempts": 5,
    "RecoveryCodeCount": 10,
    "TrustedDeviceDays": 30,
    "TotpDigits": 6,
    "TotpPeriodSeconds": 30,
    "TotpAllowedDriftSteps": 1,
    "SignInAttemptsPerMinutePerIp": 20,
    "PasswordResetRequestsPerHour": 5,
    "MaskAccountExistence": true,
    "RequireStepUpForSensitiveActions": true
  },

  "TenancySettings": {
    "RootDomain": "ngoplanet.com",
    "PlatformHosts": [ "www.ngoplanet.com", "ngoplanet.com", "admin.ngoplanet.com" ],
    "ResolveFromHost": true,
    "AllowHeaderOverrideOnLoopback": false,
    "TenantHeaderName": "X-Tenant",
    "HostResolutionCacheSeconds": 300,
    "EnforceTokenHostBinding": true
  },

  "EmailSettings": {
    "Enabled": true,

    // HOSTINGER, over SMTP, using a real mailbox on the organisation's own domain. It replaced
    // Resend, which had replaced Elastic Email, which had replaced a Gmail App Password - and the
    // provider switch that chose between them is gone with them, so this section describes one
    // relay and nothing else. Point SmtpHost elsewhere to change providers.
    //
    // PORT 465 IS IMPLICIT TLS - the handshake completes before any SMTP verb is spoken. 587 is
    // the same relay over STARTTLS and works too; the transport picks the mode from the port, so
    // switching is this number alone. 25 is closed by Hostinger and by most networks.
    "SmtpHost": "smtp.hostinger.com",
    "SmtpPort": 465,

    // BLANK, like every other credential in this file. The username is the full mailbox address
    // and the password is that mailbox's password, both supplied at run time as
    // EmailSettings__SmtpUsername and EmailSettings__SmtpPassword, which docker-compose fills
    // from IAM_SMTP_USERNAME and IAM_SMTP_PASSWORD.
    "SmtpUsername": "",
    "SmtpPassword": "",

    // HOSTINGER SENDS ONLY AS THE AUTHENTICATED MAILBOX or one of its aliases, and refuses
    // anything else outright rather than rewriting it. Blank falls back to SmtpUsername, which on
    // this relay is exactly right - the guard on that fallback only withholds it when the username
    // is not an address, which was the case on Resend. Supplied at run time as
    // EmailSettings__SenderAddress, from IAM_MAIL_FROM.
    "SenderAddress": "",
    "SenderName": "NGoPlanet",

    // IGNORED AT 465 AND 2465, which are implicit TLS. It applies on 587, where the connection
    // opens in the clear and upgrades.
    "UseStartTls": true,

    "TimeoutSeconds": 30,
    "MaximumRetries": 3
  },

  "ClientAppSettings": {
    "BaseUrl": "https://www.ngoplanet.com",
    "AllowedOrigins": [ "https://www.ngoplanet.com", "https://ngoplanet.com" ],
    "SignInPath": "/auth/sign-in",
    "InvitationPath": "/auth/invitation",
    "ResetPasswordPath": "/auth/reset-password",
    "EmailVerifyPath": "/auth/email-verify",
    "OrganisationOnboardingPath": "/app/administration/organisation/details",
    "AccessRequestPath": "/app/administration/access/access-request-and-approval",
    "AccessReviewPath": "/app/administration/access/access-review-campaign"
  },

  "SeedSettings": {
    "Enabled": true,
    "BusinessUnitCode": "BU001",
    "BusinessUnitName": "NGoPlanet",
    "RootDomain": "ngoplanet.com",
    "SuperAdminEmail": "superadmin@ngoplanet.local",
    "SuperAdminUsername": "superadmin",
    "SuperAdminFirstName": "Platform",
    "SuperAdminLastName": "Administrator",
    "SuperAdminPassword": "",
    "SeedSampleTenants": true,
    "SeedCatalogues": true
  }
}
