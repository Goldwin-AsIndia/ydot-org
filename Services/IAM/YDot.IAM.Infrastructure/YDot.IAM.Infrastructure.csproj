<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Authorization handlers, IHttpContextAccessor and the data-protection /
      password-hashing primitives live in the shared framework, so one
      FrameworkReference replaces several package references and cannot drift
      from the runtime version.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- UseSnakeCaseNamingConvention() in ServiceContainer/DependencyInjection.cs. -->
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- IdentityCore: PasswordHasher, IdentityUser/IdentityRole base tables. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- IAM is the only service that SIGNS a token, so it needs the handler. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <!-- Object storage for Organisation documents. Only MinioObjectStorage touches it. -->
    <PackageReference Include="Minio" />
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YDot.IAM.Application\YDot.IAM.Application.csproj" />
  </ItemGroup>

</Project>
