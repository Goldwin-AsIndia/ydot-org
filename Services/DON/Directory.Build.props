<Project>
  <!--
    Common build settings for the four YDots.DON.* projects.

    Everything that used to be repeated in each .csproj lives here instead, so a
    new project inside Services/DON picks up the same rules automatically.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Analyzers on, and the ones that matter treated as build breaks. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- CS8618/CS8602 and friends are warnings, not errors: they would block a
         perfectly ordinary EF Core navigation property. The four below are the
         ones that hide real defects, so they fail the build. -->
    <WarningsAsErrors>CS4014;CS1998;CS0162;CS0164</WarningsAsErrors>

    <!--
      CA1848  LoggerMessage source generators - not worth it at this request volume.
      CA2007  ConfigureAwait(false) - there is no synchronisation context in ASP.NET Core.
      CA1062  Null checks on public arguments - the nullable annotations already say this.
      CA1861  Constant arrays as static readonly - they sit inside EF expressions.
      CA1304  } ToLower() and string.Contains(string) live inside LINQ-to-Entities
      CA1311  } expressions. The culture-aware and StringComparison overloads have no
      CA1862  } SQL translation, so using them turns an index seek into a client-side
              scan of the whole table. The comparison happens in PostgreSQL under the
              database collation, not under the process locale.
      CA1305  Serilog's bootstrap Console() sink takes no format provider we care about.
      CA1873  The exception argument in the logging call is already materialised.
      CA1000  Result<T>.Success / .Failure are the whole point of the result pattern.
      CA1716  "Error" is the name the section 11 error catalogue uses. Renaming it here
              would make the code stop matching the document it implements.
      CA1859  Response DTOs expose IReadOnlyList deliberately, so a caller cannot mutate
              a collection it was handed. The suggested concrete types would undo that.
      CA1822  Some handlers legitimately need no instance state; they still have to look
              like every other handler so the controllers can call them uniformly.
    -->
    <NoWarn>$(NoWarn);CA1848;CA2007;CA1062;CA1861;CA1304;CA1311;CA1862;CA1305;CA1873;CA1000;CA1716;CA1859;CA1822</NoWarn>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>Ascending Software</Company>
    <Product>YDot Peoples Planet</Product>
    <Authors>YDot Platform Team</Authors>
  </PropertyGroup>
</Project>
