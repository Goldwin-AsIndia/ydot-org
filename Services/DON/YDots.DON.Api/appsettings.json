{
  // Serilog replaces the built-in providers, so the "Logging" section is not read any more.
  // Both sinks sit behind Async: the request thread hands the line to a background writer
  // instead of waiting on the console or the disk.
  "Seq": {
    // Blank disables the Seq sink rather than failing at startup, which is what the previous
    // unconditional WriteTo.Seq(seqUrl!) did on any deployment without a Seq server.
    "ServerUrl": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Async", "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "logs/ydot-don-.log",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 52428800,
                "retainedFileCountLimit": 30,
                "shared": true,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "AllowedHosts": "*",

  // The same "ydot" database IAM uses. The two services never share a table:
  // IAM owns iam_*, DON owns don_*, and each keeps its own migrations history table.
  "DatabaseSettings": {
    "ConnectionString": "Host=localhost;Port=5432;Database=ydot;Username=postgres;Password=user;Include Error Detail=true",
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true,
    "CommandTimeoutSeconds": 60
  },

  // DON validates the token, it never issues one. Issuer, Audience and SigningKey must match
  // the IAM values byte for byte or every call arrives as 401.
  "JwtSettings": {
    "Issuer": "YDot.IAM",
    "Audience": "YDot.Clients",
    "SigningKey": "ydot-iam-development-signing-key-change-me-in-production-2026",
    "ClockSkewSeconds": 30
  },

  "ClientAppSettings": {
    "BaseUrl": "http://localhost:6700",
    "ApplicationName": "YDot",
    "AllowedOrigins": [
      "http://localhost:6700",
      "http://localhost:6700",
      "http://localhost:6701",
      "http://localhost:6701",
      "https://localhost:6701"
    ]
  },

  "DonorSettings": {
    "DonorNumberPrefix": "DON",
    "LeadReferencePrefix": "LED",
    "MergeCaseReferencePrefix": "DUP",
    "VerificationReferencePrefix": "VER",
    "FollowUpReferencePrefix": "FUP",

    "SlaDueSoonHours": 24,
    "SlaBreachHours": 72,

    "WorkloadLightThreshold": 5,
    "WorkloadBalancedThreshold": 15,
    "WorkloadHeavyThreshold": 30,

    "VerificationCodeValidMinutes": 10,
    "VerificationMaxAttempts": 5,
    "VerificationCodeDigits": 6,

    "BulkRouteMaximumItems": 100,
    "ExportMaximumRows": 5000,

    "CurrentNoticeVersion": "PN-2026-01"
  },

  // The demonstration donors, leads and follow-ups of the two activated sample Organisations.
  // Off here; the Docker stack switches it on. Each Organisation is found by its subdomain in
  // IAM's own table, so there is no Organisation id to keep in step with any other service.
  "SeedSettings": {
    "CreateSampleData": false
  }
}
