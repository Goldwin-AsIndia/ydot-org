{
  // ===========================================================================================
  // YDot Donations and Payments API.
  //
  // NOTHING SECRET LIVES IN THIS FILE, and in this service that matters more than in the other
  // three: the values it would hold are merchant credentials that can move money. Everything
  // sensitive is supplied from the environment or the secret store:
  //
  //   DatabaseSettings__ConnectionString
  //   JwtSettings__SigningKey
  //   PaymentGateways__<reference>__ApiKey
  //   PaymentGateways__<reference>__WebhookSecret
  //   EmailSettings__SmtpPassword
  //   IdentityIntegration__ServiceAccountPassword
  //
  // THE SIGNING KEY MUST BE THE SAME STRING IAM SIGNS WITH. PAY never issues a token; it only
  // validates the one IAM signed. A mismatch presents as every request answering 401 with
  // nothing in the log to explain why.
  //
  // THE CONNECTION STRING MUST POINT AT THE SAME DATABASE AS IAM, DON AND CAM. All four share
  // one PostgreSQL database and each owns its own table prefix and its own EF migrations
  // history table: iam_* and gm_* for IAM, don_* for DON, cam_* for CAM, pay_* for PAY.
  // ===========================================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "DatabaseSettings": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": false,

    // Logs parameter VALUES - which in this service are donor names, e-mail addresses and tax
    // identifiers. Never enable outside a developer machine with test data.
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },

  "JwtSettings": {
    "SigningKey": "",
    "Issuer": "YDot.IAM",
    "Audience": "YDot.Client",

    // The framework default is five MINUTES, which quietly extends every token past its stated
    // life. Thirty seconds covers real drift between two containers and nothing more.
    "ClockSkewSeconds": 30
  },

  "PaymentSettings": {
    // How long a payment link stays usable. Long enough for a donor to find their card, short
    // enough that a link forwarded to somebody else weeks later does nothing.
    "DefaultPaymentLinkValidityMinutes": 60,

    // How long an unpaid intent survives before the expiry sweep closes it.
    "IntentExpiryHours": 72,

    // After this many failed attempts the donor is routed to Payment Support and Safe Retry
    // instead of being offered another identical button.
    //
    // TWO, because the donation flow document fixes it: the original attempt, plus the one
    // Retry the Payment Queue offers on a failed row. "If the retry ALSO fails, the payment
    // record moves to the Payment Support and Safe Retry page." At three it never moved.
    "MaximumAttemptsBeforeSupport": 2,

    "GatewayTimeoutSeconds": 30,

    // A donor who has paid is entitled to their tax receipt without anybody remembering to
    // press a button.
    "AutoIssueReceiptOnDonation": true,
    "AutoDeliverReceipt": true,

    // Section 17. Off is a legitimate configuration: a charity may take donations without
    // offering donors a portal account at all.
    "CreateDonorAccountOnSuccess": true,

    "ReceiptNumberPrefix": "RCPT",

    // FOUR: the Indian financial year runs April to March and receipt numbering follows it.
    // A deployment elsewhere will want 1 or 7. Getting this wrong numbers receipts into the
    // wrong tax year, which the donor then cannot claim.
    "FinancialYearStartMonth": 4,

    // PRESENTATION ONLY - storage and comparison stay UTC everywhere. It is the zone a date is
    // PRINTED in on a receipt, and it exists because a gift taken at 02:47 IST on 9 September is
    // 21:17 UTC on the 8th: the receipt said the 8th while the register beside it said the 9th.
    "DisplayTimeZone": "Asia/Kolkata",

    "DefaultChargebackEvidenceDays": 7,

    // MUST BE A MOUNTED VOLUME in any real deployment. A container filesystem is discarded on
    // the next deployment, and discarding donors' tax documents is not recoverable - a receipt
    // has to be reproducible for the seven-plus years a donor may be asked to justify a claim.
    "ReceiptDocumentRoot": "",

    "EventProcessingBatchSize": 100
  },

  "PaymentGateways": {
    // Each key here is the ApiKeyReference stored on a pay_gateway_accounts row. The row holds
    // only the NAME; the values below come from the environment or the secret store, so a dump
    // of the payments database contains no credential for any charity's merchant account.
    //
    // Example, supplied as environment variables rather than written here:
    //   PaymentGateways__Sandbox__BaseUrl
    //   PaymentGateways__Sandbox__ApiKey
    //   PaymentGateways__Sandbox__WebhookSecret
  },

  "IdentityIntegration": {
    // Section 17: creating the donor's portal account after a successful payment. FALSE by
    // default - an unconfigured integration that tried anyway would add a failed HTTP call and
    // a timeout to every donation for no benefit.
    "Enabled": false,
    "BaseUrl": "http://localhost:6702",

    // A SERVICE ACCOUNT with exactly one permission: iam.users.create. Not a person's login,
    // and nothing more - a compromised PAY process should be able to invite a donor and
    // nothing else. The password comes from the environment.
    "ServiceAccountUsername": "",
    "ServiceAccountPassword": "",

    // Short on purpose: this runs AFTER the money is captured, so a slow IAM must not hold the
    // donor on a spinner wondering whether their payment worked.
    "TimeoutSeconds": 10,

    "DonorAccountCategory": "DonorPortal"
  },

  "EmailSettings": {
    // Off means every receipt is written to the log instead of sent, which is enough to walk
    // the whole donate - capture - receipt flow with no mail credentials at all.
    "Enabled": false,

    // HOSTINGER, over SMTP on port 465. Kept identical to IAM's section on purpose: one set of
    // environment variables configures mail for the whole platform, rather than IAM sending and
    // PAY silently not. Resend, Elastic Email and the Gmail App Password before it are gone, along
    // with the provider switch that chose between them.
    //
    // 465 IS SAFE FOR THIS SERVICE NOW, AND WAS NOT BEFORE. It is implicit TLS, which the
    // System.Net.Mail client this sender used to be built on could not speak at all - it connected
    // in the clear and stalled for twenty seconds until the timeout, while IAM sent on the same
    // port and credentials in three. SmtpEmailSender is MailKit now, the same transport as IAM's.
    "SmtpHost": "smtp.hostinger.com",
    "SmtpPort": 465,

    // Blank, like every other credential in this file. The username is the full mailbox address
    // and the password is that mailbox's password, both supplied at run time as
    // EmailSettings__SmtpUsername and EmailSettings__SmtpPassword, which docker-compose fills from
    // IAM_SMTP_USERNAME and IAM_SMTP_PASSWORD.
    "SmtpUsername": "",
    "SmtpPassword": "",

    // HOSTINGER SENDS ONLY AS THE AUTHENTICATED MAILBOX or one of its aliases. A receipt is a tax
    // document, so it should come from the charity's own domain - which is what that mailbox is.
    // Blank falls back to SmtpUsername, correct on this relay; the guard on that fallback only
    // withholds it when the username is not an address, as it was on Resend.
    "SenderAddress": "",
    "SenderName": "YDot Donations",

    // IGNORED AT 465 AND 2465, which are implicit TLS. It applies on 587.
    "UseStartTls": true,

    "TimeoutSeconds": 30,

    // Set this in any non-production environment. A test database restored from production
    // contains real donors and real receipts, and mailing them tax documents from a test
    // environment is a mistake that only has to happen once.
    "RedirectAllToAddress": null
  },

  "ClientAppSettings": {
    // An explicit list, never a wildcard: the client sends a bearer token and credentials, and
    // a browser refuses to send credentials to a wildcard origin.
    "AllowedOrigins": [
      "http://localhost:6701",
      "http://localhost:6700",
      "http://localhost:6702"
    ],
    "BaseUrl": "http://localhost:6701",

    // Where the gateway sends the donor back to. The intent reference is appended, and the page
    // then calls the public verification endpoint.
    "PaymentResultPath": "/give/result",

    "DonorActivationPath": "/auth/activate",

    // Where a receipt links back to. It is combined with the ORGANISATION'S OWN HOST - the
    // scheme and port come from BaseUrl, the host from iam_tenant_domains - because the
    // Organisation is resolved from the host, and a link on the platform host resolves the
    // wrong one.
    "ReceiptsPath": "/app/donations/payment-event-queue"
  },

  "Seq": {
    // Blank disables the Seq sink rather than failing at startup.
    "ServerUrl": ""
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Sinks.Seq"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },

    "Enrich": [ "FromLogContext" ],

    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/pay-.log",
                "rollingInterval": "Day",

                // Longer than the other services'. When a donor asks in March what happened to
                // a payment in January, the log is where the answer is.
                "retainedFileCountLimit": 90,

                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {ServiceName} {CorrelationId} {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": ""
        }
      }
    ]
  }
}
