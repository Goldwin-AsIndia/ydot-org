{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // THIS FILE IS GIT-IGNORED, which is the only reason a real credential may sit in it.
  //
  // IT EXISTS SO THAT A LOCAL PAY RUN SENDS THE WAY A LOCAL IAM RUN DOES. Without this section
  // PAY falls back to the tracked appsettings.json, where Enabled is false - so IAM would mail an
  // invitation from a developer's machine while PAY logged the donor's receipt and called it
  // delivered. A container run never had the problem, because docker-compose hands both services
  // the same EmailSettings__* values out of .env; only a local run split them.
  //
  // KEEP IT IN STEP WITH IAM'S appsettings.Development.json. Two files, one relay: if the password
  // is rotated in one and not the other, receipts and invitations start disagreeing about whether
  // mail works.
  "EmailSettings": {
    "Enabled": true,

    // HOSTINGER over SMTP, port 465 with implicit TLS. The username is the full mailbox address
    // and the password is that mailbox's, rotated in hPanel under Emails.
    //
    // 465 WORKS HERE NOW. It did not while SmtpEmailSender was built on System.Net.Mail, which has
    // no implicit-TLS mode: it connected in the clear and stalled twenty seconds until the
    // timeout. That sender is MailKit now, the same transport IAM uses.
    //
    // THE CREDENTIALS ARE NOT IN THIS FILE, AND MUST NOT BE PUT BACK. THIS FILE IS TRACKED BY GIT
    // - .gitignore covers .env and .env.example and nothing else - so anything written here is one
    // `git commit` away from being permanent. They live in user secrets instead, outside the
    // repository, loaded automatically in Development:
    //
    //   dotnet user-secrets set "EmailSettings:SmtpUsername" "notifications@yourdomain.com" \
    //     --project Services/PAY/YDot.PAY.Api
    //   dotnet user-secrets set "EmailSettings:SmtpPassword" "<mailbox password>" \
    //     --project Services/PAY/YDot.PAY.Api
    //
    // A CONTAINER RUN READS .env INSTEAD, via EmailSettings__* in docker-compose.yml. Rotate in
    // both, and in IAM's store too - one relay, three places that hold its password.
    "SmtpHost": "smtp.hostinger.com",
    "SmtpPort": 465,
    "SmtpUsername": "",
    "SmtpPassword": "",

    // IGNORED AT 465, which is implicit TLS. It would apply on 587.
    "UseStartTls": true,

    // THE AUTHENTICATED MAILBOX ITSELF. Hostinger sends only as that mailbox or one of its
    // aliases, so unlike the previous provider this cannot be a per-service address - IAM's
    // noreply@ and a separate receipts@ are not available unless they are added as aliases in
    // hPanel. Until then both services send as the same mailbox, which is why SenderName is what
    // distinguishes a receipt from an invitation to the person receiving it.
    "SenderAddress": "notifications@ascendingsoftware.com",
    "SenderName": "NGoPlanet Donations",

    // THE GUARD THAT MATTERS MOST IN THIS SERVICE. A development database restored from
    // production holds real donors and real receipts; this makes it impossible to mail them a
    // tax document from a laptop.
    "RedirectAllToAddress": "rajat.sivan@gmail.com"
  }
}
